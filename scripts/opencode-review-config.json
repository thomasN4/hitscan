{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "snapshot": false,
  "autoupdate": false,
  "enabled_providers": ["opencode"],
  "provider": {
    "opencode": {
      "models": {
        "muse-spark-1.3-contributor-free": {
          "name": "Muse Spark 1.3 Free (OpenCode Zen)",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 1048576,
            "output": 943718
          },
          "variants": {
            "high": {
              "reasoning": {
                "effort": "high"
              }
            }
          }
        }
      }
    }
  },
  "permission": {
    "*": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "external_directory": "deny"
  },
  "agent": {
    "review": {
      "description": "Review a pull request from immutable base and head snapshots without changing or executing repository content.",
      "mode": "primary",
      "permission": {
        "*": "deny",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "external_directory": "deny"
      }
    }
  }
}
