{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",

    "strict": true,
    // Unchecked index reads on input-mutated state (WEAPONS[game.slot],
    // zoomFovs[game.zoomLevel]) are the exact regression class this gate
    // exists for. Every fix is a decision about what happens on a miss.
    "noUncheckedIndexedAccess": true,

    // Incremental migration: .js files stay in the program (their inferred
    // types feed consumers) but are not themselves checked.
    "allowJs": true,
    "checkJs": false,

    // Vite/esbuild does all transpiling; tsc is a pure checker here.
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
